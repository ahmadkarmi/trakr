# Supabase Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env files to version control!

# Your Supabase project URL (found in Project Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase service role key (found in Project Settings > API)
# This is the "service_role" key, NOT the "anon" key
# IMPORTANT: Keep this secret! It has admin privileges
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Web App Configuration (REQUIRED for production)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here
VITE_BACKEND=supabase

# Authentication (REQUIRED for production)
# Use a strong password, NOT the example below
VITE_DEFAULT_PASSWORD=your_secure_password_here

# Sentry Error Tracking (Optional but recommended for production)
VITE_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
VITE_APP_VERSION=1.0.0

# Sentry Build-time Configuration (for source map uploads)
# Only needed during production builds, not runtime
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG=your-org-slug
SENTRY_PROJECT=trakr-web

# Optional Configuration
VITE_DEMO_VIDEO_URL=https://your-demo-video-url.com
VITE_BETA_REQUEST_EMAIL=contact@yourdomain.com
VITE_LANDING_HERO_IMAGE=/LandingPageMockUpHeroSectionTrakr.png

# Usage Examples:
# For database seeding: npm run seed:db
# For web development: npm run dev:web
# For production: Set these in Vercel dashboard
