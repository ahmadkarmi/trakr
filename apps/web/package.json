{
  "name": "@trakr/web",
  "version": "1.0.0",
  "description": "Trakr Web Application",
  "type": "module",
  "scripts": {
    "dev": "cross-env VITE_BACKEND=supabase vite --port 3002 --host",
    "build": "vite build",
    "build:local": "cross-env VITE_BACKEND=supabase tsc && vite build",
    "build:analyze": "cross-env VITE_BACKEND=supabase tsc && vite build --mode analyze",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@headlessui/react": "^1.7.0",
    "@heroicons/react": "^2.0.0",
    "@sentry/react": "^10.20.0",
    "@sentry/vite-plugin": "^4.4.0",
    "@supabase/supabase-js": "^2.58.0",
    "@tanstack/query-sync-storage-persister": "^5.90.2",
    "@tanstack/react-query": "^5.90.10",
    "@tanstack/react-query-persist-client": "^5.90.2",
    "@trakr/shared": "file:../../packages/shared",
    "ag-grid-community": "^34.3.1",
    "ag-grid-react": "^34.2.0",
    "clsx": "^2.0.0",
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "plotly.js": "^3.1.1",
    "react": "^18.2.0",
    "react-countup": "^6.5.3",
    "react-date-range": "^2.0.1",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "react-plotly.js": "^2.6.0",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.9.2",
    "tailwind-merge": "^2.0.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^6.3.0",
    "@testing-library/react": "^14.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^24.5.2",
    "@types/plotly.js": "^3.0.6",
    "@types/react": "^18.2.0",
    "@types/react-date-range": "^1.4.10",
    "@types/react-dom": "^18.2.0",
    "@types/react-plotly.js": "^2.6.3",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^6.14.0",
    "autoprefixer": "^10.4.22",
    "cross-env": "^10.1.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.5",
    "jsdom": "^22.1.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
