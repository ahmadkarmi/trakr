{
  "name": "@trakr/web",
  "version": "1.0.0",
  "description": "Trakr Web Application",
  "type": "module",
  "scripts": {
    "dev": "cross-env VITE_BACKEND=supabase vite --port 3002 --host",
    "build": "vite build",
    "build:local": "cross-env VITE_BACKEND=supabase tsc && vite build",
    "build:analyze": "cross-env VITE_BACKEND=supabase tsc && vite build --mode analyze",
    "preview": "vite preview",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@heroicons/react": "^2.0.0",
    "@sentry/react": "^10.69.0",
    "@sentry/vite-plugin": "^5.4.0",
    "@supabase/supabase-js": "^2.111.0",
    "@tanstack/query-sync-storage-persister": "^5.101.4",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-persist-client": "^5.101.4",
    "@trakr/shared": "file:../../packages/shared",
    "ag-grid-community": "^36.0.2",
    "ag-grid-react": "^36.0.2",
    "clsx": "^2.0.0",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "plotly.js": "^3.1.1",
    "react": "^19.2.8",
    "react-countup": "^6.5.3",
    "react-date-range": "^2.0.1",
    "react-dom": "^19.2.8",
    "react-hot-toast": "^2.6.0",
    "react-plotly.js": "^4.1.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.3.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^24.5.2",
    "@types/plotly.js": "^3.0.6",
    "@types/react": "^19.2.17",
    "@types/react-date-range": "^1.4.10",
    "@types/react-dom": "^19.2.3",
    "@types/react-plotly.js": "^2.6.3",
    "@typescript-eslint/eslint-plugin": "^6.14.0",
    "@typescript-eslint/parser": "^8.65.0",
    "cross-env": "^10.1.0",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": "22.x"
  }
}
